# Telegram Bot Configuration
# Bot token received from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Comma-separated list of Telegram user IDs who have global admin access
ADMIN_IDS=123456789,987654321

# Optional comma-separated list of group chat IDs the bot is allowed to operate in.
# If left empty, the bot operates in any forum supergroup it is added to.
ALLOWED_CHAT_IDS=

# Optional proxy URL for both Telegram API and AI API calls.
# Supports HTTP and SOCKS5 (e.g., socks5://127.0.0.1:1080 or http://127.0.0.1:8080).
# Leave empty for direct connection.
PROXY_URL=

# AI Provider Configuration ('9router', 'openai', or 'gemini')
AI_PROVIDER=9router

# 9Router Settings (primary OpenAI-compatible AI gateway; local 9Router automatically bypasses PROXY_URL)
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=sk-Your9RouterApiKeyHere
NINEROUTER_MODEL=antigravity/gemini-2.5-flash

# Google Gemini Direct API Settings (optional, used if AI_PROVIDER=gemini)
GEMINI_API_KEY=AQ.YourGeminiApiKeyHere
GEMINI_MODEL=gemini-3.8-flash

# Optional Generic OpenAI-compatible API Settings (fallback if NINEROUTER_* is unset or AI_PROVIDER=openai)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# AI Output Token Limit (default 8192, generationConfig.maxOutputTokens / max_tokens)
AI_MAX_OUTPUT_TOKENS=8192
# Optional reasoning effort for 9Router / OpenAI-compatible gateways (e.g. none, low, medium, high).
# Note: Newer Gemini models on 9Router (e.g. ag/gemini-3.8-flash-medium) reject MINIMAL and accept low/medium/high (auto-recovered if left empty).
AI_REASONING_EFFORT=

# Interactive AI Chat (Independent Client, toggled via /manage_ai)
# AI_CHAT_PROVIDER can be '9router' (default), 'openai', or 'gemini'
AI_CHAT_PROVIDER=9router
# Optional 9Router overrides for AI chat (each falls back to NINEROUTER_* / OPENAI_* if empty)
AI_CHAT_NINEROUTER_BASE_URL=
AI_CHAT_NINEROUTER_API_KEY=
AI_CHAT_NINEROUTER_MODEL=
AI_CHAT_NINEROUTER_FALLBACK_MODELS=
# Optional generic OpenAI-compatible overrides for AI chat
AI_CHAT_OPENAI_BASE_URL=
AI_CHAT_OPENAI_API_KEY=
AI_CHAT_OPENAI_MODEL=
AI_CHAT_OPENAI_FALLBACK_MODELS=
# Optional Google Gemini fallback settings for AI chat (used if toggled to Gemini via /manage_ai)
AI_CHAT_API_KEY=
AI_CHAT_MODEL=gemini-3.5-flash-lite
AI_CHAT_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.8-flash,gemini-3.6-flash
AI_CHAT_MAX_OUTPUT_TOKENS=600
AI_CHAT_TEMPERATURE=0.85
AI_CHAT_HISTORY_LIMIT=8
AI_CHAT_USER_LIMIT_COUNT=20
AI_CHAT_USER_LIMIT_WINDOW_SECONDS=7200

# Thresholds & Limits
# Minimum valid messages in a topic to trigger summarization
MIN_MESSAGES_PER_TOPIC=5
# Minimum character length of a message after trimming to be captured
MIN_MESSAGE_LENGTH=3
# Maximum characters for transcript before map-reduce chunking kicks in
CHUNK_MAX_CHARS=24000

# Nightly Schedule (Asia/Tehran timezone)
SUMMARY_TIME_HOUR=0
SUMMARY_TIME_MINUTE=1
TIMEZONE=Asia/Tehran

# Data Retention & Cleanup
# Days of message history to keep before purging
RETENTION_DAYS=7

# Delay between sending split message chunks or topic summaries (in seconds) to prevent flood limits
SEND_DELAY_SECONDS=1.8

# AI API call retries on retryable errors (408, 429, 5xx, network timeouts)
AI_MAX_RETRIES=3
# Dedicated retry budget on transient throttle errors (HTTP 429 and transient HTTP 402)
AI_THROTTLE_MAX_RETRIES=6
# Delay after each LLM request finishes before the next call (in seconds) to pace 9Router / upstream RPM & TPM
AI_CHUNK_DELAY_SECONDS=2.0

# Storage & Paths
DB_PATH=data/bot.db
LOG_DIR=logs
LOG_LEVEL=INFO

# Private Chat & Group Membership Behavior
# Display names of bot owners shown in private responses
OWNER_NAMES=آرش و پیت
# Notify ADMIN_IDS via DM on first private contact from an unknown user (true/false)
NOTIFY_ON_UNKNOWN_START=true
# Automatically leave groups not listed in ALLOWED_CHAT_IDS when added (true/false)
AUTO_LEAVE_UNKNOWN_GROUPS=false

# Interactive Timer & Reminder Settings
# Maximum concurrent active timers allowed per user (default 15)
TIMER_MAX_PER_USER=15
# Days to retain fired/cancelled timer records before cleanup (default 30)
TIMER_RETENTION_DAYS=30

# Daily Morning Greeting (Hills / Prime)
# Daily send time in TIMEZONE (default 05:01 Asia/Tehran)
MORNING_GREETING_HOUR=5
MORNING_GREETING_MINUTE=1
# Start date of Hills (YYYY-MM-DD, counted as Day 1)
HILLS_START_DATE=2026-08-28
# Latest Tehran hour to send a missed morning greeting on startup catch-up
MORNING_CATCHUP_END_HOUR=11
